# App URL
# Usa el dominio publico real que ve el navegador; no el host tecnico azurewebsites.net
NEXTAUTH_URL=https://<tu-dominio-publico>
NEXT_PUBLIC_BASE_URL=https://<tu-dominio-publico>
DEFAULT_PAGE_PATH=/

# NextAuth
NEXTAUTH_SECRET=<genera-un-secreto-largo-y-unico>
MOBILE_JWT_SECRET=
# Opcional: corta mas rapido los intentos de login si SQL/Azure se queda colgado
AUTH_LOOKUP_TIMEOUT_MS=15000

# SQL Server
# Usa solo una de estas opciones:
SQLSERVER_CONN=Server=tcp:<servidor>.database.windows.net,1433;Initial Catalog=<base>;Persist Security Info=False;User ID=<usuario>;Password=<password>;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;

# Alternativa por variables separadas
# DB_SERVER=<servidor>.database.windows.net
# DB_NAME=<base>
# DB_USER=<usuario>
# DB_PASSWORD=<password>
# DB_ENCRYPT=true
# DB_TRUST_SERVER_CERTIFICATE=false
# DB_CONNECTION_TIMEOUT_MS=5000
# DB_REQUEST_TIMEOUT_MS=8000
# DB_POOL_MIN=0
# DB_POOL_MAX=5
# DB_POOL_IDLE_MS=30000

# Azure Blob Storage para imagenes de noticias
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<cuenta>;AccountKey=<clave>;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=<contenedor-publico>
AZURE_STORAGE_ACCOUNT_NAME=<cuenta>
# Opcional: si usas CDN o dominio propio para leer las imagenes
# AZURE_STORAGE_PUBLIC_BASE_URL=https://<cuenta>.blob.core.windows.net/<contenedor-publico>
# Opcional: limite maximo en MB
# AZURE_STORAGE_MAX_UPLOAD_MB=10
